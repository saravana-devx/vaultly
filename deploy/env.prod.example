# Copy to .env on the SERVER (never commit it). Generate each secret with the command shown.
#
# Public hostname. A real domain, or "<server-ip>.sslip.io" (e.g. 203.0.113.7.sslip.io) if you have none.
DOMAIN=

# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 24   (hex only: it is placed inside a connection URL)
POSTGRES_PASSWORD=
# openssl rand -hex 24
REDIS_PASSWORD=

# Leave empty on a fresh install: OpenBao is the root of trust. Only set this if you are migrating
# data that was wrapped with an old MASTER_KEY (then run: server rewrap).
MASTER_KEY=

# Optional SMTP for invitation emails (e.g. Resend, Brevo, Gmail app password). If SMTP_HOST is empty
# emails are only logged, and the admin still gets the invite link in the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: where to build the rate-limiter service from. Default is its GitHub repository;
# if that repo is private, clone it next to this one and set the path, e.g. ../Distributed-rate-limiter
# RATELIMITER_SRC=
