# Copy to .env and fill in. Generate with:
#   JWT_SECRET: openssl rand -hex 32
#   MASTER_KEY: openssl rand -base64 32
#     required if KEY_PROVIDER=local; with the default OpenBao setup it is OPTIONAL and is only
#     used to read project keys that have not been migrated yet (run `server rewrap`).
JWT_SECRET=
MASTER_KEY=
