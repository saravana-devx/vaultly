# Copy to .env (cp .env.example .env) and set JWT_SECRET. .env is never committed.
# Vaultly settings for the DEV stack (docker compose up / make up).
# Every value below has a default in docker-compose.yml, so a missing line never breaks the stack.
# Production uses its own file: see deploy/env.prod.example.

# ---- secrets ------------------------------------------------------------------------------------
# JWT_SECRET: openssl rand -hex 32          (required, 32+ characters)
JWT_SECRET=
# MASTER_KEY: openssl rand -base64 32       (optional with OpenBao; only reads keys not yet migrated)
MASTER_KEY=

# ---- application --------------------------------------------------------------------------------
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# openbao (recommended) or local (uses MASTER_KEY)
KEY_PROVIDER=openbao
KEY_CACHE_TTL_SECONDS=60
KAFKA_AUDIT_TOPIC=vaultly.audit
# true lets webhooks call private addresses (needed for local testing only)
WEBHOOK_ALLOW_PRIVATE=true

# ---- mail (dev: Mailpit catches every email) ------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@vaultly.local

# ---- database -----------------------------------------------------------------------------------
POSTGRES_USER=vaultly
POSTGRES_PASSWORD=vaultly
POSTGRES_DB=vaultly

# ---- rate-limiter service -------------------------------------------------------------------------
# Folder (or Git URL) of the Distributed-rate-limiter project it is built from.
RATELIMITER_SRC=../../Distributed-rate-limiter
RATELIMITER_DB_USER=ratelimiter
RATELIMITER_DB_PASSWORD=ratelimiter
RATELIMITER_DB_NAME=ratelimiter

# ---- ports published on your machine ------------------------------------------------------------
APP_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9094
MAIL_UI_PORT=8025
BAO_PORT=8200
